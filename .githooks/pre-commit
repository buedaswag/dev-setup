#!/usr/bin/env bash
# Secret scan, reporting only: a commit is a local save point and this never blocks
# one. pre-push is the gate. scripts/secret_scan.sh says why.
#
# Install (once per clone):
#   git config core.hooksPath .githooks

# pipeline: advisory
scripts/secret_scan.sh || echo "pre-commit: commit allowed -- the PUSH WILL BLOCK until this is fixed." >&2
exit 0

{
  "permissions": {
    "allow": [
      "Read(//Users/migueldias/ws/personal/CV/**)",
      "Read(file_path:/Users/migueldias/ws/**)",
      "Read(file_path:/Users/migueldias/.claude/**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(tail:*)",
      "Bash(python -m unittest:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(bd blocked*)",
      "Bash(bd children*)",
      "Bash(bd context*)",
      "Bash(bd count*)",
      "Bash(bd diff*)",
      "Bash(bd export*)",
      "Bash(bd graph*)",
      "Bash(bd help*)",
      "Bash(bd history*)",
      "Bash(bd human*)",
      "Bash(bd info*)",
      "Bash(bd lint*)",
      "Bash(bd list*)",
      "Bash(bd memories*)",
      "Bash(bd onboard*)",
      "Bash(bd prime*)",
      "Bash(bd query*)",
      "Bash(bd quickstart*)",
      "Bash(bd ready*)",
      "Bash(bd recall*)",
      "Bash(bd search*)",
      "Bash(bd show*)",
      "Bash(bd stale*)",
      "Bash(bd state*)",
      "Bash(bd status*)",
      "Bash(bd statuses*)",
      "Bash(bd types*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfvars.json)",
      "Read(**/.tfenv)",
      "Read(**/.tfenv.*)",
      "Bash(cat *.env*)",
      "Bash(cat *.tfvars*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/ws/dev-setup/claude/guards/command_guard.py\" || exit 2"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cp /Users/migueldias/ws/personal/interview-prep/.claude/skills/interview-prep.md ~/.claude/skills/interview-prep.md && cp /Users/migueldias/ws/personal/CV/.cursor/skills/adapt-cv/SKILL.md ~/.claude/skills/adapt-cv/SKILL.md"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/migueldias/ws/dev-setup/claude/sync.sh 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "agentPushNotifEnabled": true
}
